# 시크릿 — 실제 값은 .env.local 에만 넣는다 (커밋 금지). 이 파일은 플레이스홀더 템플릿이다.
# 브라우저에는 절대 내려가지 않는다 — app/api/reply/stream/route.ts(Next.js 서버)에서만
# 읽어 FastAPI 요청 헤더에 붙인다.

# 루트 .env 의 CS_API_KEY 와 반드시 동일한 값이어야 한다.
CS_API_KEY=replace_with_a_long_random_value

# FastAPI 백엔드 주소 (Next.js 서버 -> FastAPI)
FASTAPI_BASE_URL=http://localhost:8000
